# Browser-safe Supabase values used by the static frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only values used by vite.config.js and netlify/functions.
# Never prefix this key with VITE_ and never expose it to browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required only for AI and document extraction features.
ANTHROPIC_API_KEY=your-anthropic-api-key